{
  "name": "ip-locator",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "start": "node --use-env-proxy run-server.js",
    "dev": "node --use-env-proxy --watch run-server.js",
    "test": "node --test",
    "build": "node scripts/build-page.js",
    "prestart": "npm run build",
    "predev": "npm run build",
    "build:windows": "npm run build && node scripts/build-windows.js",
    "pretest": "npm run build",
    "test:browser": "node scripts/check-browser.js"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.23.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
